# Copy to .env for local runs (git ignores .env). On Railway, set these under the service's Variables tab.
NEWSINTEL_LIVE=1
NEWSINTEL_DB=/data/newsintel.db          # on the mounted volume, so it survives restarts and deploys
PUBLIC_BASE_URL=https://your-app.up.railway.app
ADMIN_TOKEN=                             # long random password for owner-only actions (manual refresh, tests)

# Optional: Claude summaries (without it, cards show the source's own description as "Limited summary")
ANTHROPIC_API_KEY=
NEWSINTEL_MODEL=claude-sonnet-5-5

# Email briefings (Resend's SMTP shown; any SMTP provider works)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=                           # your Resend API key
MAIL_FROM=Sift <briefing@yourdomain.com>  # must be on the domain you verified with SPF + DKIM

# Optional overrides. If unset, the server generates these once and keeps them in its database.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=                           # defaults to PUBLIC_BASE_URL
UNSUBSCRIBE_SECRET=
# Offline demo instead of live feeds:
# NEWSINTEL_FIXTURE=fixtures/articles_2026-11-19.json
# NEWSINTEL_REVIEWED=fixtures/summaries_2026-11-19.json
